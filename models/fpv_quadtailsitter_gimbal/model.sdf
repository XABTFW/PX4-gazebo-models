<?xml version="1.0"?>
<sdf version="1.10">
  <model name="fpv_quadtailsitter_gimbal">
    <include merge="true">
      <uri>model://fpv_quadtailsitter/base.sdf</uri>
    </include>

    <!-- Keep the original airspeed sensor and its orientation, without the rod visual. -->
    <link name="airspeed_link">
      <pose>0 0 0.7 0 -1.57 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <iyy>1e-05</iyy>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <sensor name="air_speed" type="air_speed">
        <gz_frame_id>airspeed_link</gz_frame_id>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="airspeed_joint" type="fixed">
      <parent>base_link</parent>
      <child>airspeed_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>

    <!-- Nose tip is at Z=0.630 m; recess the mount bottom to Z=0.628 m. -->
    <link name="gimbal_mount_link">
      <pose>0 0 0.634 0 0 0</pose>
      <inertial>
        <mass>0.006</mass>
        <inertia>
          <ixx>4.6e-07</ixx>
          <iyy>4.6e-07</iyy>
          <izz>7.5e-07</izz>
        </inertia>
      </inertial>
      <visual name="mount">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <geometry><cylinder><radius>0.016</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
    </link>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>gimbal_mount_link</child>
    </joint>

    <link name="gimbal_yaw_link">
      <pose>0 0 0.644 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>2e-06</ixx><iyy>2e-06</iyy><izz>3e-06</izz></inertia>
      </inertial>
      <visual name="yaw_base">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.068 0.028 0.008</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>gimbal_mount_link</parent>
      <child>gimbal_yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>0.3</effort></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <link name="gimbal_roll_link">
      <pose>0 0 0.678 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>3e-06</ixx><iyy>5e-06</iyy><izz>3e-06</izz></inertia>
      </inertial>
      <visual name="left_arm">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <pose>0 -0.03 -0.013 0 0 0</pose>
        <geometry><box><size>0.012 0.006 0.032</size></box></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
      <visual name="right_arm">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <pose>0 0.03 -0.013 0 0 0</pose>
        <geometry><box><size>0.012 0.006 0.032</size></box></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
      <visual name="arm_base">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <pose>0 0 -0.027 0 0 0</pose>
        <geometry><box><size>0.012 0.066 0.006</size></box></geometry>
        <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_roll_joint" type="revolute">
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.785398</lower><upper>0.785398</upper><effort>0.3</effort></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <!-- Camera +X points along aircraft +Z at zero joint command (standing tailsitter). -->
    <link name="camera_link">
      <pose>0 0 0.678 0 -1.5707963267948966 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>5.76e-06</ixx><iyy>5.76e-06</iyy><izz>5.76e-06</izz></inertia>
      </inertial>
      <collision name="camera_collision">
        <geometry><sphere><radius>0.024</radius></sphere></geometry>
      </collision>
      <visual name="camera_body">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <geometry><sphere><radius>0.024</radius></sphere></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="lens_barrel">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <pose>0.023 0 0 0 1.5707963267948966 0</pose>
        <geometry><cylinder><radius>0.013</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <visual name="lens_glass">
        <transparency>1</transparency>
        <cast_shadows>false</cast_shadows>
        <pose>0.0295 0 0 0 1.5707963267948966 0</pose>
        <geometry><cylinder><radius>0.0105</radius><length>0.001</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.08 0.14 1</ambient><diffuse>0.02 0.08 0.14 1</diffuse>
          <specular>0.7 0.8 0.9 1</specular>
        </material>
      </visual>
      <sensor name="camera_imu" type="imu">
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
      </sensor>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.031 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15000</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>camera_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.35619</lower><upper>0.785398</upper><effort>0.3</effort></limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>

    <!-- Velocity-based position servos avoid torque PID chatter at these small inertias. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_roll_joint</joint_name>
      <sub_topic>command/gimbal_roll</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <initial_position>0</initial_position>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_pitch_joint</joint_name>
      <sub_topic>command/gimbal_pitch</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <initial_position>0</initial_position>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_yaw_joint</joint_name>
      <sub_topic>command/gimbal_yaw</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <initial_position>0</initial_position>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
    </plugin>
  </model>
</sdf>
