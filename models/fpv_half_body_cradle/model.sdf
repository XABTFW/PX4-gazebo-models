<?xml version="1.0"?>
<sdf version="1.9">
  <model name="fpv_half_body_cradle">
    <!-- Fixed to the world: aircraft contact must never translate or tip the cradle. -->
    <static>true</static>
    <self_collide>false</self_collide>
    <!-- Upright reference-shaped prop: local +X is the long axis, rotated
         into world +Z by the link pose. The opening is now in the FRONT END,
         not the former upper/side panel. Aircraft remains an independent body. -->
